{
  "manifest_version": 3,
  "name": "Local Lens",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "description": "__MSG_appDescription__",
  "version": "1.4.0",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "notifications"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: https://tessdata.projectnaptha.com https://huggingface.co https://cas-bridge.xethub.hf.co;"
  }
}
