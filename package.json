{
  "name": "local-lens",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild:models": "node scripts/fetch-paddle-models.mjs",
    "build": "npm run prebuild:models && tsc && rm -rf dist && VITE_ENTRY=background vite build && VITE_ENTRY=content vite build && VITE_ENTRY=offscreen vite build && cp -r public/* dist/",
    "preview": "vite preview",
    "test": "vitest run --project unit --project browser",
    "test:watch": "vitest --project unit --project browser",
    "test:structured": "vitest run --project structured",
    "test:ui-snapshots": "vitest run --project snapshots",
    "test:bench": "npm run prebuild:models && vitest run --project bench",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@webgpu/types": "^0.1.69",
    "happy-dom": "^20.11.1",
    "playwright": "^1.60.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.6",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "onnxruntime-web": "^1.26.0",
    "ppu-doclayout": "^1.0.0",
    "ppu-paddle-ocr": "^6.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "turndown": "^7.2.2"
  }
}
